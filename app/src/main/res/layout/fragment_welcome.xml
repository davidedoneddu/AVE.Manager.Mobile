<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/welcome_fragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/top_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="-0.1" />
    <!-- Background image -->
    <ImageView
        android:id="@+id/image_background"
        android:layout_width="0dp"
        android:layout_height="0dp"

        android:scaleType="centerCrop"
        android:src="@drawable/welcome_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Logo AVE MANAGER -->


    <View
        android:id="@+id/blue_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#80004388"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <!-- Bottone ENTRA -->


    <View
        android:id="@+id/radial_underlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/radial_underlay"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/top_guideline"
        app:layout_constraintVertical_bias="0.0"
        />

    <ImageView
        android:id="@+id/text_logo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_welcome"
        app:layout_constraintWidth_percent="0.9"
        app:layout_constraintDimensionRatio="H,413:298"
        app:layout_constraintTop_toTopOf="@+id/radial_underlay"
        app:layout_constraintBottom_toBottomOf="@+id/radial_underlay"
        app:layout_constraintStart_toStartOf="@+id/radial_underlay"
        app:layout_constraintEnd_toEndOf="@+id/radial_underlay"

        />

    <Button
        android:id="@+id/button_enter"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="172dp"
        android:backgroundTint="@color/material_dynamic_primary60"
        android:text="ENTRA"
        android:textColor="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>